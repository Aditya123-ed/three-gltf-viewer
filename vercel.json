{
    "routes": [
        {
            "src": "/models/client.glb",
            "headers": {
                "cache-control": "no-store"
            },
            "dest": "/api/client-model"
        },
        {
            "src": "/models/client\\.annotations\\.json",
            "dest": "/api/client-annotations"
        },
        {
            "src": "/model-check",
            "dest": "/api/model-check"
        },
        {
            "src": "/environments/(.*)",
            "headers": {
                "cache-control": "max-age=604800, public"
            },
            "dest": "/environments/$1"
        },
        {
            "src": "/assets/(.*)",
            "headers": {
                "cache-control": "max-age=604800, public"
            },
            "dest": "/assets/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/public/$1"
        }
    ],
    "functions": {
        "api/client-model.mjs": {
            "maxDuration": 300
        }
    }
}
